# Copy this file to ".env" and fill in your values. NEVER commit ".env".

# Get a free key at https://aistudio.google.com/apikey  (click "Create API key")
GEMINI_API_KEY=your-gemini-api-key-here

# Model to use. Google renames/retires models often - check https://ai.google.dev/gemini-api/docs/models
# The app tries this one first, then the fallbacks in GEMINI_FALLBACK_MODELS.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash

# Secret used to sign login tokens (JWT). Use any long random string.
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=120

# SQLite database file (created automatically)
DATABASE_PATH=pocketsmart.db
